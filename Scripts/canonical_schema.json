  "fnsku_bidirectional_lock": {
    "keys": [
      "brand",
      "size",
      "strips_per_pack",
      "color",
      "product_name_zh"
    ],
    "note": "规格↔FNSKU双向成立；颜色为核心维；亚马逊只认FNSKU；克重不参与锁定、不阻断标签复制"
  },

  },
  "label_output_layout": {
    "fixed": true,
    "confirmed_at": "2026-07-21",
    "pattern": "产品标签/{order_code}标签/{strips_per_pack}条装/{size_folder}/{source_filename}",
    "rules": [
      "order_code must start with EF",
      "bundle folder name = order_code + 标签",
      "no FNSKU in folder or file names",
      "PDF filename must equal label-source original name",
      "classify by strips_per_pack then size_folder only"
    ],
    "example": "产品标签/EF-C26079-C04-36460标签/6条装/60x102/102象牙白色ivory6条.pdf"
  },
    "order_workbook_layout": {
    "status": "locked_c26079_master",
    "file": "Templates/order_layout_master.xlsx",
    "fill_mode": "clone_master_change_fields_only",
    "upper_grain": "size+color",
    "lower_grain": "size+color+strips_per_pack+fnsku",
    "row_count_fixed": false,
    "expand": "insert_or_delete_before_section_total; remake_merges",
    "packing_display": {
      "authority": "settled packing_standards LWH + C26079 cell wording",

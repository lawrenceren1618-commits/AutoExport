  "fnsku_bidirectional_lock": {
    "keys": [
      "brand",
      "size",
      "strips_per_pack",
      "color",
      "product_name_zh"
    ],
    "note": "规格↔FNSKU双向成立；颜色为核心维；亚马逊只认FNSKU；克重不参与锁定键",
    "gsm_interchange": {
      "confirmed_at": "2026-07-29",
      "doc": "Templates/Ship_Stats_Correspondence.md",
      "interchangeable_gsm": [90, 110],
      "rule": "同公司同规格维下 90克与110克可互通同一FNSKU；标签匹配不因90/110克重夹差异阻断",
      "not_interchangeable_with": [150],
      "other_gsm": "不得套用与90/110互通；冲突走 error-confirm-gate"
    }
  },
  "amazon_sku_lock": {
    "confirmed_at": "2026-07-23",
    "doc": "Templates/SKU_Correspondence.md",
    "field": "amazon_sku",
    "aliases": ["SKU", "卖家SKU", "MSKU", "Merchant SKU"],
    "unique_within": ["entity_code", "brand"],
    "immutable_on_amazon": true,
    "cross_store": false,
    "note": "SKU 在同一店铺+品牌内唯一且亚马逊侧基本不可改；与 FNSKU 并存。夹名/页标与 SKU 冲突时以已沉淀 SKU 或人工备注为准。",
    "manual_note_path": "Shipments/{project}/拆单比对/SKU_人工备注.md",
    "priority_after_settled": [
      "sku_index",
      "label_or_pdf_sku",
      "folder_name_and_page_marks",
      "plan_fnsku_fallback"
    ]
  },

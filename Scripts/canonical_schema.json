    "note": "米白=象牙白=Ivory 为同一色（使用者确认）；规范化写入沉淀/匹配时归一为「米白」"
  },
  "label_output_layout": {
    "fixed": true,
    "confirmed_at": "2026-07-21",
    "pattern": "产品标签/{order_code}标签/{strips_per_pack}条装/{size_folder}/{source_filename}",
    "rules": [
      "order_code must start with EF",
      "bundle folder name = order_code + 标签",
      "no FNSKU in folder or file names",
      "PDF filename must equal label-source original name",
      "classify by strips_per_pack then size_folder only"
    ],
    "example": "产品标签/EF-C26079-C04-36460标签/6条装/60x102/102象牙白色ivory6条.pdf"
  },
  "size_folder_map": {
    "confirmed_at": "2026-07-21",
    "to_folder": {
      "60X102inch": "60x102",
      "60*102inch": "60x102",
      "60x102": "60x102",
      "6x102": "60x102",
      "102": "60x102",
      "60X126inch": "60x126",

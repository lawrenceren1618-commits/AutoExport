# Office CP — OFCE 环境变量示例（复制为 web/.env.local，勿提交真实密钥）

# 运行环境自检：必须为 office，防止误连家里项目
OFCE_ENV=office

# Supabase（办公室独立项目 office-cp-ofce）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 可选：后台简易口令（无 Supabase Auth 时的开发门闩）
OFCE_ADMIN_PASSWORD=change-me

# AutoExport — copy to web/.env.local and paste values after =

OFCE_ENV=office
OFCE_ADMIN_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=autoexport

# Python generator bridge (local office default = local)
# local | off | http
PYTHON_RUNNER=local
# PYTHON_BIN=python
# PYTHON_WORKER_URL=
# PYTHON_WORKER_SECRET=

# Execution plane: local | cloud | auto (default auto = Vercel→cloud, else local)
# See Templates/Local_Cloud_Execution_Plane.md
EXECUTION_PLANE=auto

# OCR — primary = tesseract / PDF text (sufficient with human confirm gates)
# LlamaParse = reference only; do NOT enable unless experimenting
# OCR_DUAL_COMPARE=on
# LLAMA_CLOUD_API_KEY=
